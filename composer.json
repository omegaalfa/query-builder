{
  "name": "omegaalfa/query-builder",
  "type": "library",
  "description": "Um Query Builder moderno e minimalista em PHP 8+, totalmente tipado e baseado em PDO, com suporte a cache, paginação, transações e geração fluente de SQL.",
  "keywords": [
    "php",
    "query builder",
    "pdo",
    "database",
    "sql",
    "orm",
    "pagination",
    "cache",
    "omegaalfa"
  ],
  "homepage": "https://github.com/omegaalfa/query-builder",
  "license": "MIT",
  "authors": [
    {
      "name": "wrt",
      "email": "webdesenvolver.agenda@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-ctype": "*"
  },
  "autoload": {
    "psr-4": {
      "Omegaalfa\\QueryBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "quality:stan": "phpstan analyse --configuration=phpstan.neon",
    "quality:cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes --config=.php-cs-fixer.php",
    "quality:mutation": "infection --configuration=infection.json5 --test-framework=phpunit --min-msi=50",
    "quality": [
      "@quality:stan",
      "@quality:cs"
    ],
    "benchmark:compare": "php -d xdebug.mode=off benchmarks/compare-doctrine.php",
    "benchmark:pgvector": "php -d xdebug.mode=off benchmarks/pgvector.php",
    "benchmark:pgvector-overhead": "php -d xdebug.mode=off benchmarks/pgvector-overhead.php",
    "benchmark:database": "php -d xdebug.mode=off benchmarks/database-workloads.php",
    "benchmark:pgvector-search": "php -d xdebug.mode=off benchmarks/pgvector-search.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "infection/infection": "^0.29",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5.8",
    "doctrine/dbal": "^4.4",
    "illuminate/database": "^12.37"
  },
  "suggest": {
    "ext-redis": "Required only when using RedisCache"
  }
}
