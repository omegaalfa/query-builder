{
  "name": "omegaalfa/query-builder",
  "type": "library",
  "description": "Um Query Builder moderno e minimalista em PHP 8+, totalmente tipado e baseado em PDO, com suporte a cache, paginação, transações e geração fluente de SQL.",
  "keywords": [
    "php",
    "query builder",
    "pdo",
    "database",
    "sql",
    "orm",
    "pagination",
    "cache",
    "omegaalfa"
  ],
  "homepage": "https://github.com/omegaalfa/query-builder",
  "license": "MIT",
  "authors": [
    {
      "name": "wrt",
      "email": "webdesenvolver.agenda@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-ctype": "*"
  },
  "autoload": {
    "psr-4": {
      "Omegaalfa\\QueryBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "test:docker": "docker compose -f docker-compose.test.yml run --build --rm php-test composer test",
    "quality:stan": "phpstan analyse --configuration=phpstan.neon",
    "quality:cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes --config=.php-cs-fixer.php",
    "quality:mutation": "infection --configuration=infection.json5 --test-framework=phpunit --only-covered --threads=1 --min-msi=60",
    "quality": [
      "@quality:stan",
      "@quality:cs"
    ],
    "quality:docker": "docker compose -f docker-compose.test.yml run --build --rm php-test composer quality",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "docker:test:reset": "docker compose -f docker-compose.test.yml down --volumes"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "infection/infection": "^0.29",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5.8"
  },
  "suggest": {
    "ext-redis": "Required only when using RedisCache"
  }
}
