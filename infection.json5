{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.29.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    "tmpDir": ".infection",
    "mutators": {
        "@default": true
    }
}
